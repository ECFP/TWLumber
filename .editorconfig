# Top-most EditorConfig file
root = true

# All C# files
[*.cs]

############################
# Namespace Style
############################
# Enforce file-scoped namespaces (C# 10+)
csharp_style_namespace_declarations = file_scoped:warning

############################
# Modern C# Style Preferences
############################
# Prefer 'var' when type is apparent
csharp_style_var_when_type_is_apparent = true:suggestion

# Prefer explicit type when type is not apparent
csharp_style_var_elsewhere = false:suggestion

# Prefer 'using' directives outside namespace
csharp_style_prefer_top_level_statements = true:suggestion

# Prefer expression-bodied members when possible
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Prefer pattern matching over 'is' with cast
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# Prefer 'readonly' for fields that can be readonly
dotnet_style_readonly_field = true:warning

############################
# Formatting Rules
############################
# Indentation
indent_style = space
indent_size = 4

# Line endings
end_of_line = crlf

# Charset
charset = utf-8-bom

# Trim trailing whitespace
trim_trailing_whitespace = true

# Insert final newline
insert_final_newline = true
